@page "/dashboard"
@using facturationApp.Models
@using facturationApp.Services
@inject IFactureService FactureService
@inject IClientService ClientService
@inject IProduitService ProduitService
@rendermode InteractiveServer

<h3 class="mb-4">📊 Tableau de bord analytique</h3>

@if (factures == null)
{
    <p>Chargement...</p>
}
else
{
    <!-- KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h6 class="card-title">CA Total HT</h6>
                    <h4>@caHT.ToString("F3") TND</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h6 class="card-title">CA Total TTC</h6>
                    <h4>@caTTC.ToString("F3") TND</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h6 class="card-title">TVA Collectée</h6>
                    <h4>@totalTVA.ToString("F3") TND</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger">
                <div class="card-body">
                    <h6 class="card-title">Total Timbres</h6>
                    <h4>@totalTimbre.ToString("F3") TND</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-dark">
                <div class="card-body">
                    <h6 class="card-title">Nb Factures</h6>
                    <h4>@factures.Count</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h6 class="card-title">Nb Clients</h6>
                    <h4>@nbClients</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-secondary">
                <div class="card-body">
                    <h6 class="card-title">Nb Produits</h6>
                    <h4>@nbProduits</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white" style="background:#6f42c1">
                <div class="card-body">
                    <h6 class="card-title">Moy. Facture TTC</h6>
                    <h4>@moyFacture.ToString("F3") TND</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== FILTRE PÉRIODE ===== -->
    <div class="card p-3 mb-4 border-primary">
        <h5>🗓️ Filtre par période</h5>
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold">Date début</label>
                <InputDate class="form-control" @bind-Value="dateDebut" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Date fin</label>
                <InputDate class="form-control" @bind-Value="dateFin" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" @onclick="FiltrerPeriode">
                    🔍 Filtrer
                </button>
            </div>
            <div class="col-md-2">
                <button class="btn btn-secondary w-100" @onclick="ResetFiltres">
                    ↺ Reset
                </button>
            </div>
        </div>
    </div>

    <!-- Résultat période -->
    @if (facturesFiltrees != null)
    {
        <div class="row g-3 mb-4">
            <div class="col-12">
                <h6 class="text-muted">
                    Résultats du @dateDebut.ToString("dd/MM/yyyy")
                    au @dateFin.ToString("dd/MM/yyyy")
                    — @facturesFiltrees.Count facture(s)
                </h6>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-primary">
                    <div class="card-body">
                        <h6>CA HT (période)</h6>
                        <h4>@facturesFiltrees.Sum(f => f.TotalHT).ToString("F3") TND</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-success">
                    <div class="card-body">
                        <h6>CA TTC (période)</h6>
                        <h4>@facturesFiltrees.Sum(f => f.TotalTTC).ToString("F3") TND</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-warning">
                    <div class="card-body">
                        <h6>TVA (période)</h6>
                        <h4>@facturesFiltrees.Sum(f => f.TotalTVA).ToString("F3") TND</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-danger">
                    <div class="card-body">
                        <h6>Timbres (période)</h6>
                        <h4>@facturesFiltrees.Sum(f => f.TimbreFiscal).ToString("F3") TND</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- CA par client sur période -->
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card p-3">
                    <h5>👤 CA par client (période)</h5>
                    <table class="table table-sm table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Client</th>
                                <th>CA HT</th>
                                <th>CA TTC</th>
                                <th>Nb Factures</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in facturesFiltrees
                                .GroupBy(f => f.Client?.Nom ?? "Inconnu")
                                .Select(g => new {
                                    Nom = g.Key,
                                    CaHT = g.Sum(f => f.TotalHT),
                                    CaTTC = g.Sum(f => f.TotalTTC),
                                    Nb = g.Count()
                                })
                                .OrderByDescending(x => x.CaTTC))
                            {
                                <tr>
                                    <td>@item.Nom</td>
                                    <td>@item.CaHT.ToString("F3") TND</td>
                                    <td>@item.CaTTC.ToString("F3") TND</td>
                                    <td>@item.Nb</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- CA par produit sur période -->
            <div class="col-md-6">
                <div class="card p-3">
                    <h5>📦 CA par produit (période)</h5>
                    <table class="table table-sm table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Produit</th>
                                <th>Qté</th>
                                <th>CA HT</th>
                                <th>CA TTC</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in facturesFiltrees
                                .SelectMany(f => f.Lignes)
                                .GroupBy(l => l.Produit?.Designation ?? "Inconnu")
                                .Select(g => new {
                                    Designation = g.Key,
                                    Qte = g.Sum(l => l.Quantite),
                                    CaHT = g.Sum(l => l.TotalHT),
                                    CaTTC = g.Sum(l => l.TotalTTC)
                                })
                                .OrderByDescending(x => x.CaTTC))
                            {
                                <tr>
                                    <td>@item.Designation</td>
                                    <td>@item.Qte</td>
                                    <td>@item.CaHT.ToString("F3") TND</td>
                                    <td>@item.CaTTC.ToString("F3") TND</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- ===== CA PAR CLIENT GLOBAL ===== -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card p-3">
                <h5>👤 CA par client — Global (HT / TTC)</h5>
                <table class="table table-sm table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Client</th>
                            <th>CA HT</th>
                            <th>CA TTC</th>
                            <th>Nb Factures</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in caParClient)
                        {
                            <tr>
                                <td>@item.Nom</td>
                                <td>@item.CaHT.ToString("F3") TND</td>
                                <td>@item.CaTTC.ToString("F3") TND</td>
                                <td>@item.NbFactures</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="fw-bold table-secondary">
                        <tr>
                            <td>TOTAL</td>
                            <td>@caParClient.Sum(x => x.CaHT).ToString("F3") TND</td>
                            <td>@caParClient.Sum(x => x.CaTTC).ToString("F3") TND</td>
                            <td>@caParClient.Sum(x => x.NbFactures)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- TVA par taux -->
        <div class="col-md-6">
            <div class="card p-3">
                <h5>🏦 TVA collectée par taux</h5>
                <table class="table table-sm table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Taux TVA</th>
                            <th>Base HT</th>
                            <th>TVA collectée</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in tvaParTaux)
                        {
                            <tr>
                                <td>@item.Taux %</td>
                                <td>@item.BaseHT.ToString("F3") TND</td>
                                <td>@item.MontantTVA.ToString("F3") TND</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="fw-bold table-secondary">
                        <tr>
                            <td>TOTAL</td>
                            <td>@tvaParTaux.Sum(x => x.BaseHT).ToString("F3") TND</td>
                            <td>@tvaParTaux.Sum(x => x.MontantTVA).ToString("F3") TND</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- ===== CA PAR PRODUIT GLOBAL ===== -->
    <div class="row g-3 mb-4">
        <div class="col-md-12">
            <div class="card p-3">
                <h5>📦 CA par produit — Global (HT / TTC)</h5>
                <table class="table table-sm table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Produit</th>
                            <th>Qté vendue</th>
                            <th>CA HT</th>
                            <th>CA TTC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in caParProduit)
                        {
                            <tr>
                                <td>@item.Designation</td>
                                <td>@item.QteTotale</td>
                                <td>@item.CaHT.ToString("F3") TND</td>
                                <td>@item.CaTTC.ToString("F3") TND</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="fw-bold table-secondary">
                        <tr>
                            <td colspan="2">TOTAL</td>
                            <td>@caParProduit.Sum(x => x.CaHT).ToString("F3") TND</td>
                            <td>@caParProduit.Sum(x => x.CaTTC).ToString("F3") TND</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- ===== CA MENSUEL ===== -->
    <div class="row g-3 mb-4">
        <div class="col-md-12">
            <div class="card p-3">
                <h5>📅 CA mensuel — @DateTime.Today.Year (HT / TTC)</h5>
                <table class="table table-sm table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Mois</th>
                            <th>CA HT</th>
                            <th>CA TTC</th>
                            <th>TVA</th>
                            <th>Timbres</th>
                            <th>Nb Factures</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in caMensuel)
                        {
                            <tr>
                                <td><strong>@item.Mois</strong></td>
                                <td>@item.CaHT.ToString("F3") TND</td>
                                <td>@item.CaTTC.ToString("F3") TND</td>
                                <td>@item.TVA.ToString("F3") TND</td>
                                <td>@item.Timbres.ToString("F3") TND</td>
                                <td>@item.NbFactures</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="fw-bold table-secondary">
                        <tr>
                            <td>TOTAL</td>
                            <td>@caMensuel.Sum(x => x.CaHT).ToString("F3") TND</td>
                            <td>@caMensuel.Sum(x => x.CaTTC).ToString("F3") TND</td>
                            <td>@caMensuel.Sum(x => x.TVA).ToString("F3") TND</td>
                            <td>@caMensuel.Sum(x => x.Timbres).ToString("F3") TND</td>
                            <td>@caMensuel.Sum(x => x.NbFactures)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private List<Facture>? factures;
    private int nbClients;
    private int nbProduits;
    private decimal caHT;
    private decimal caTTC;
    private decimal totalTVA;
    private decimal totalTimbre;
    private decimal moyFacture;

    private DateTime dateDebut = new DateTime(DateTime.Today.Year, 1, 1);
    private DateTime dateFin = DateTime.Today;
    private List<Facture>? facturesFiltrees;

    private List<CaClientDto> caParClient = new();
    private List<TvaParTauxDto> tvaParTaux = new();
    private List<CaProduitDto> caParProduit = new();
    private List<CaMensuelDto> caMensuel = new();

    protected override async Task OnInitializedAsync()
    {
        factures = await FactureService.GetAllAsync();
        nbClients = (await ClientService.GetAllAsync()).Count;
        nbProduits = (await ProduitService.GetAllAsync()).Count;

        CalculerIndicateurs();
    }

    private void CalculerIndicateurs()
    {
        if (factures == null) return;

        caHT = factures.Sum(f => f.TotalHT);
        caTTC = factures.Sum(f => f.TotalTTC);
        totalTVA = factures.Sum(f => f.TotalTVA);
        totalTimbre = factures.Sum(f => f.TimbreFiscal);
        moyFacture = factures.Any() ? factures.Average(f => f.TotalTTC) : 0;

        // CA par client HT + TTC
        caParClient = factures
            .GroupBy(f => f.Client?.Nom ?? "Inconnu")
            .Select(g => new CaClientDto
            {
                Nom = g.Key,
                CaHT = g.Sum(f => f.TotalHT),
                CaTTC = g.Sum(f => f.TotalTTC),
                NbFactures = g.Count()
            })
            .OrderByDescending(x => x.CaTTC)
            .ToList();

        // TVA par taux
        tvaParTaux = factures
            .SelectMany(f => f.Lignes)
            .GroupBy(l => l.TauxTVA)
            .Select(g => new TvaParTauxDto
            {
                Taux = g.Key,
                BaseHT = g.Sum(l => l.TotalHT),
                MontantTVA = g.Sum(l => l.TotalTVA)
            })
            .OrderBy(x => x.Taux)
            .ToList();

        // CA par produit HT + TTC
        caParProduit = factures
            .SelectMany(f => f.Lignes)
            .GroupBy(l => l.Produit?.Designation ?? "Inconnu")
            .Select(g => new CaProduitDto
            {
                Designation = g.Key,
                QteTotale = g.Sum(l => l.Quantite),
                CaHT = g.Sum(l => l.TotalHT),
                CaTTC = g.Sum(l => l.TotalTTC)
            })
            .OrderByDescending(x => x.CaTTC)
            .ToList();

        // CA mensuel
        var moisNoms = new[] { "", "Jan", "Fév", "Mar", "Avr", "Mai", "Jun",
                                "Jul", "Aoû", "Sep", "Oct", "Nov", "Déc" };
        caMensuel = factures
            .Where(f => f.DateFacture.Year == DateTime.Today.Year)
            .GroupBy(f => f.DateFacture.Month)
            .Select(g => new CaMensuelDto
            {
                Mois = moisNoms[g.Key],
                NumMois = g.Key,
                CaHT = g.Sum(f => f.TotalHT),
                CaTTC = g.Sum(f => f.TotalTTC),
                TVA = g.Sum(f => f.TotalTVA),
                Timbres = g.Sum(f => f.TimbreFiscal),
                NbFactures = g.Count()
            })
            .OrderBy(x => x.NumMois)
            .ToList();
    }

    private void FiltrerPeriode()
    {
        facturesFiltrees = factures?
            .Where(f => f.DateFacture.Date >= dateDebut.Date
                     && f.DateFacture.Date <= dateFin.Date)
            .ToList();
    }

    private void ResetFiltres()
    {
        dateDebut = new DateTime(DateTime.Today.Year, 1, 1);
        dateFin = DateTime.Today;
        facturesFiltrees = null;
    }

    // DTOs
    private class CaClientDto
    {
        public string Nom { get; set; } = "";
        public decimal CaHT { get; set; }
        public decimal CaTTC { get; set; }
        public int NbFactures { get; set; }
    }

    private class TvaParTauxDto
    {
        public decimal Taux { get; set; }
        public decimal BaseHT { get; set; }
        public decimal MontantTVA { get; set; }
    }

    private class CaProduitDto
    {
        public string Designation { get; set; } = "";
        public int QteTotale { get; set; }
        public decimal CaHT { get; set; }
        public decimal CaTTC { get; set; }
    }

    private class CaMensuelDto
    {
        public string Mois { get; set; } = "";
        public int NumMois { get; set; }
        public decimal CaHT { get; set; }
        public decimal CaTTC { get; set; }
        public decimal TVA { get; set; }
        public decimal Timbres { get; set; }
        public int NbFactures { get; set; }
    }
}