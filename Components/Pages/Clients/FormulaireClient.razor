@page "/clients/nouveau"
@page "/clients/{Id:int}"
@using facturationApp.Services
@using facturationApp.Models
@inject IClientService ClientService
@inject NavigationManager Nav
@rendermode InteractiveServer

<h3>@(Id == null ? "➕ Nouveau client" : "✏️ Modifier le client")</h3>

<div class="card p-4 mt-3" style="max-width:600px">
    <EditForm Model="client" OnValidSubmit="Sauvegarder">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <div class="mb-3">
            <label class="form-label fw-bold">Nom *</label>
            <InputText class="form-control" @bind-Value="client.Nom"
                       placeholder="Nom du client" />
            <ValidationMessage For="() => client.Nom" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Matricule Fiscal</label>
            <InputText class="form-control" @bind-Value="client.MatriculeFiscal"
                       placeholder="ex: 1234567/A/M/000" />
            <div class="form-text">Format tunisien : XXXXXXX/A/M/000</div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Email *</label>
            <InputText class="form-control" @bind-Value="client.Email"
                       placeholder="email@exemple.com" />
            <ValidationMessage For="() => client.Email" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Téléphone</label>
            <InputText class="form-control" @bind-Value="client.Telephone"
                       placeholder="+216 XX XXX XXX" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Adresse</label>
            <InputTextArea class="form-control" rows="2"
                           @bind-Value="client.Adresse"
                           placeholder="Adresse complète" />
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-floppy me-1"></i> Sauvegarder
            </button>
            <button type="button" class="btn btn-secondary"
                    @onclick='() => Nav.NavigateTo("/clients")'>
                <i class="bi bi-arrow-left me-1"></i> Annuler
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public int? Id { get; set; }
    private Client client = new();

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            var existing = await ClientService.GetByIdAsync(Id.Value);
            if (existing != null) client = existing;
        }
    }

    private async Task Sauvegarder()
    {
        if (Id.HasValue)
            await ClientService.UpdateAsync(client);
        else
            await ClientService.CreateAsync(client);

        Nav.NavigateTo("/clients");
    }
}