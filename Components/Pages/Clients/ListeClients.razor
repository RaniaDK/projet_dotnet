@page "/clients/nouveau"
@page "/clients/{Id:int}"
@using facturationApp.Models
@using facturationApp.Services
@inject IClientService ClientService
@inject NavigationManager Nav
@rendermode InteractiveServer

<h3>@(Id == null ? "➕ Nouveau client" : "✏️ Modifier le client")</h3>

@if (message != null)
{
    <div class="alert alert-success">@message</div>
}

<div class="card p-4" style="max-width:600px">
    <EditForm Model="client" OnValidSubmit="Sauvegarder">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <div class="mb-3">
            <label class="form-label fw-bold">Nom *</label>
            <InputText class="form-control" @bind-Value="client.Nom" />
            <ValidationMessage For="() => client.Nom" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Email *</label>
            <InputText class="form-control" @bind-Value="client.Email" />
            <ValidationMessage For="() => client.Email" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Téléphone</label>
            <InputText class="form-control" @bind-Value="client.Telephone" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Adresse</label>
            <InputTextArea class="form-control" rows="2" @bind-Value="client.Adresse" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">💾 Sauvegarder</button>
            <button type="button" class="btn btn-secondary"
                    @onclick='() => Nav.NavigateTo("/clients")'>Annuler</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public int? Id { get; set; }
    private Client client = new();
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            var existing = await ClientService.GetByIdAsync(Id.Value);
            if (existing != null) client = existing;
        }
    }

    private async Task Sauvegarder()
    {
        if (Id.HasValue)
            await ClientService.UpdateAsync(client);
        else
            await ClientService.CreateAsync(client);

        Nav.NavigateTo("/clients");
    }
}
